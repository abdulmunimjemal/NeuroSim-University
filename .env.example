# Copy this file to .env and fill in your API keys
# Run: cp .env.example .env

# ===================
# LLM Provider
# ===================
# Options: "openai" (recommended, uses structured output) or "gemini"
# OpenAI is default and recommended for best accuracy
LLM_PROVIDER=openai

# ===================
# API Keys
# ===================

# OpenAI - REQUIRED (uses structured output for reliable parsing)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini (alternative, falls back to JSON parsing)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
